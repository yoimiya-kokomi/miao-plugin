  "cons": {
    "1": {
      "name": "「不曾起舞的清晨，她望向倒影」",
      "desc": [
        "施放特殊元素战技<span style=\"color:#FFD780FF;\"><u>柔板·破晓终奏</u></span>后，在共舞结束时，奥黛塔将对附近的敌人造成一次额外的<span style=\"color:#99FFFFFF;\">冰元素范围伤害</span>，该伤害视为：",
        "·<span style=\"color:#FFD780FF;\">辉映·星超导</span>或不处于辉映状态：相当于奥黛塔攻击力300%的星超导反应伤害；",
        "·<span style=\"color:#FFD780FF;\">辉映·星扩散</span>：相当于奥黛塔攻击力450%的星扩散反应伤害。",
        "此外，突破天赋「获选者的春祭」获得强化：召唤<span style=\"color:#FFD780FF;\"><u>独舞倒影</u></span>时，奥黛塔将额外获得2层<span style=\"color:#FFD780FF;\"><u>华彩</u></span>，且奥黛塔处于队伍后台时，清除<span style=\"color:#FFD780FF;\">华彩</span>的速度提升至每秒2层。",
        "<h3>● 华彩</h3>",
        "解锁突破天赋「获选者的春祭」后，奥黛塔召唤<span style=\"color:#FFD780FF;\">独舞倒影</span>时将会获得的特殊效果。",
        "每层<span style=\"color:#FFD780FF;\">华彩</span>都会使角色造成的星烁反应伤害提升15%，持续至<span style=\"color:#FFD780FF;\">独舞倒影</span>退场或重新召唤<span style=\"color:#FFD780FF;\">独舞倒影</span>。",
        "当奥黛塔处于队伍后台时，奥黛塔每秒会清除1层<span style=\"color:#FFD780FF;\">华彩</span>，并使队伍中附近的其他角色获得对应层数的<span style=\"color:#FFD780FF;\">华彩</span>。"
      ]
    },
    "2": {
      "name": "「她想，我要见证雪鹄未见之梦」",
      "desc": [
        "突破天赋「获选者的春祭」获得强化：每层<span style=\"color:#FFD780FF;\"><u>华彩</u></span>还会使角色的攻击力提升7%。",
        "此外，<span style=\"color:#FFD780FF;\"><u>独舞倒影</u></span>在场时，若奥黛塔处于<span style=\"color:#FFD780FF;\"><u>辉映·星烁</u></span>状态，<span style=\"color:#FFD780FF;\">独舞倒影</span>附近敌人的对应元素抗性还会降低20%：",
        "·<span style=\"color:#FFD780FF;\">辉映·星超导</span>：<span style=\"color:#99FFFFFF;\">冰元素</span>、<span style=\"color:#FFACFFFF;\">雷元素</span>；",
        "·<span style=\"color:#FFD780FF;\">辉映·星扩散</span>：<span style=\"color:#99FFFFFF;\">冰元素</span>、<span style=\"color:#80FFD7FF;\">风元素</span>。"
      ]
    },
    "3": {
      "name": "「我要追逐呼啸的风，向上独行」",
      "desc": [
        "元素战技<span style=\"color:#FFD780FF;\"><u>柔板·幻灵夜舞</u></span>的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "4": {
      "name": "「向上，坠往恍惚、燃烧的蓝空」",
      "desc": [
        "元素爆发<span style=\"color:#FFD780FF;\">疾板·苍羽一梦</span>获得强化：奥黛塔获得<span style=\"color:#FFD780FF;\">雪鹄之梦</span>时，还会使队伍中附近的其他角色造成的星烁反应伤害提升，提升值相当于<span style=\"color:#FFD780FF;\">雪鹄之梦</span>效果的50%。",
        "此外，队伍中的角色对敌人造成星烁反应伤害时，奥黛塔还会对敌人进行一次协同攻击，造成一次<span style=\"color:#99FFFFFF;\">冰元素范围伤害</span>，每3.5秒至多触发一次，该伤害视为：",
        "·<span style=\"color:#FFD780FF;\">辉映·星超导</span>或不处于辉映状态：相当于奥黛塔攻击力66%的星超导反应伤害；",
        "·<span style=\"color:#FFD780FF;\">辉映·星扩散</span>：相当于奥黛塔攻击力99%的星扩散反应伤害。"
      ]
    },
    "5": {
      "name": "「看呀，我已告别尘与土的苦痛」",
      "desc": [
        "元素爆发<span style=\"color:#FFD780FF;\"><u>疾板·苍羽一梦</u></span>的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "6": {
      "name": "「伸出手，触及苍穹永恒的面容」",
      "desc": [
        "突破天赋「获选者的春祭」获得强化：奥黛塔赋予队伍中附近的所有角色<span style=\"color:#FFD780FF;\"><u>华彩</u></span>时，自己的华彩不再会减少。",
        "此外，处于<span style=\"color:#FFD780FF;\">华彩</span>影响下的角色，对敌人造成的星烁反应伤害<span style=\"color:#FFD780FF;\"><u>擢升</u></span>25%，且奥黛塔对敌人造成的星烁反应伤害额外擢升20%。",
        "<h3>● 擢升</h3>",
        "特殊的伤害提升效果，与其他的伤害提升效果分别独立计算。"
      ]
    }
  },
  "passive": [
    {
      "name": "获选者的春祭",
      "desc": [
        "奥黛塔召唤<span style=\"color:#FFD780FF;\"><u>独舞倒影</u></span>时，还会获得4层<span style=\"color:#FFD780FF;\"><u>华彩</u></span>。"
      ]
    },
    {
      "name": "赤忱者的悲歌",
      "desc": [
        "基于奥黛塔攻击力超过1000点的部分，每100点攻击力都将使奥黛塔造成的星烁反应伤害额外造成原本1.5%的伤害，至多通过这种方式额外造成原本30%的伤害。"
      ]
    },
    {
      "name": "星耀祝礼·银晓之舞",
      "desc": [
        "处于<span style=\"color:#FFD780FF;\"><u>极星辉域</u></span>中时/队伍中的角色在附近触发星扩散反应后的8秒内，奥黛塔将分别进入<span style=\"color:#FFD780FF;\">辉映·星超导</span>/<span style=\"color:#FFD780FF;\">辉映·星扩散</span>状态。",
        "队伍中的角色触发超导/冰元素扩散反应时，将转为触发星超导/星扩散反应，且基于奥黛塔的攻击力，提升队伍中角色造成的上述反应的基础伤害：每100点攻击力都将提升0.7%上述反应的基础伤害，至多通过这种方式提升14%伤害。",
        "<h3>● 极星辉域</h3>",
        "触发星超导反应时，附近的区域会短暂变化为<span style=\"color:#FFD780FF;\">极星辉域</span>；处于极星辉域中时，特定角色将会进入<span style=\"color:#FFD780FF;\">辉映·星超导</span>状态，使其不同技能分别获得对应的强化效果。"
      ]
    },
    {
      "name": "回响中的冬梦",
      "desc": [
        "在小地图上显示周围的<span style=\"color:#FFD780FF;\">至冬区域特产</span>的位置。",
        "在闲暇时练习舞蹈，或许还会触发其他的效果…"
      ]
    }
  ],
