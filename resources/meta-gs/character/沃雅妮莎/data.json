  "cons": {
    "1": {
      "name": "命座1",
      "desc": [
        "沃雅妮莎每次进行治疗时，会使附近队伍中角色的攻击力提升，提升值基于沃雅妮莎生命值上限的0.7%，持续3秒。"
      ]
    },
    "2": {
      "name": "命座2",
      "desc": [
        "每次麦克风攻击时，沃雅妮莎将获得<span style=\"color:#FFD780FF;\">「合奏」</span>效果，使当前场上角色的<span style=\"color:#80C0FFFF;\">水元素伤害</span>与<span style=\"color:#99FFFFFF;\">冰元素伤害</span>的暴击伤害提升50%，持续5秒；",
        "若场上存在或最近存在过<span style=\"color:#FFD780FF;\">「流荡风旋」</span>，<span style=\"color:#FFD780FF;\">「合奏」</span>会被异化为<span style=\"color:#FFD780FF;\">「变奏」</span>，使当前场上角色造成的星扩散反应的暴击伤害提升60%，持续5秒。",
        "此外，元素战技的<span style=\"color:#FFD780FF;\">麦克风召唤</span>持续时间延长9秒。"
      ]
    },
    "3": {
      "name": "命座3",
      "desc": [
        "元素战技<span style=\"color:#FFD780FF;\"><u>元素战技</u> </span>的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "4": {
      "name": "命座4",
      "desc": [
        "沃雅妮莎每次进行治疗时，将基于被治疗角色的生命值获得不同效果：",
        "· 若被治疗角色生命值低于40%，此次治疗量提升50%；",
        "· 若被治疗角色生命值高于40%，将使沃雅妮莎自身生命值提升20%，持续6秒，至多叠加3层，每层独立计时。"
      ]
    },
    "5": {
      "name": "命座5",
      "desc": [
        "元素爆发<span style=\"color:#FFD780FF;\"><u>元素爆发</u> </span>的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "6": {
      "name": "命座6",
      "desc": [
        "命座2里，<span style=\"color:#FFD780FF;\">「合奏」</span>或<span style=\"color:#FFD780FF;\">「变奏」</span>将对附近队伍中角色全体生效",
        "此外，元素战技的<span style=\"color:#FFD780FF;\">麦克风召唤</span>期间，附近队伍中角色造成的星扩散伤害擢升25%，造成的<span style=\"color:#80C0FFFF;\">水元素伤害</span>与<span style=\"color:#99FFFFFF;\">冰元素伤害</span>提升50%。"
      ]
    }
  },
  "passive": [
    {
      "name": "突破天赋1",
      "desc": [
        "元素战技持续期间，队伍内生成的星辉风旋将转为<span style=\"color:#FFD780FF;\">「流荡风旋」</span>，流荡风旋生成和引爆时会使附近敌人的<span style=\"color:#80FFD7FF;\">风元素抗性</span>降低30%，持续6秒。"
      ]
    },
    {
      "name": "突破天赋2",
      "desc": [
        "进入<span style=\"color:#FFD780FF;\">麦克风召唤</span>状态时，沃雅妮莎获得17层<span style=\"color:#FFD780FF;\"><u>「独奏」</u></span>和10层<span style=\"color:#FFD780FF;\"><u>「协奏」</u></span>。",
        "<h3>● 独奏</h3>",
        "当前场上角色的普通攻击、重击、下落攻击、元素战技或元素爆发造成<span style=\"color:#80C0FFFF;\">水元素伤害</span>与<span style=\"color:#99FFFFFF;\">冰元素伤害</span>时，将消耗一层「独奏」提升本次伤害。",
        "若场上存在或最近存在过<span style=\"color:#FFD780FF;\">「流荡风旋」</span>，「独奏」会被异化成<span style=\"color:#FFD780FF;\">「星·独奏」</span>，变成只有角色的星扩散反应能够消耗层数和提升伤害。",
        "基于沃雅妮莎生命值上限超过？？？的部分，每1000点生命值上限将使星扩散伤害提升？？？点，使<span style=\"color:#80C0FFFF;\">水元素伤害</span>与<span style=\"color:#99FFFFFF;\">冰元素伤害</span>提升？？？点。",
        "通过这种方式至多使星扩散伤害提升？？？点，使<span style=\"color:#80C0FFFF;\">水元素伤害</span>与<span style=\"color:#99FFFFFF;\">冰元素伤害</span>提升？？？点。",
        "<h3>● 协奏</h3>",
        "「协奏」和「独奏」效果一致，但只对队伍中附近非当前场上角色生效。",
        "若场上存在或最近存在过<span style=\"color:#FFD780FF;\">「流荡风旋」</span>，「协奏」也会被异化成<span style=\"color:#FFD780FF;\">「星·协奏」</span>。"
      ]
    },
    {
      "name": "固有天赋",
      "desc": [
        "在非战斗状态下，元素战技长按可以持续消耗体力使沃雅妮莎在人鱼形态下高速移动，期间可以在水面移动，持续一段时间、体力耗尽或再次施放元素战技可以退出状态。",
        "另外，沃雅妮莎在游泳状态下也会以更高的体力消耗换来更快的移动速度……"
      ]
    },
