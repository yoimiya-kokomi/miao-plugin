  "passive": [
    {
      "name": "基准承压测验",
      "desc": [
        "元素战技<span style=\"color:#FFD780FF;\">律定·变量侦测</span>创造的<span style=\"color:#FFD780FF;\">侦测炉心</span>获得强化。若创造的<span style=\"color:#FFD780FF;\">侦测炉心</span>为：",
        "·稳态：每携带一枚<span style=\"color:#FFD780FF;\">递变信标</span>，都会使队伍中附近的所有角色的元素精通提升30点；",
        "·过载：队伍中附近的所有角色触发星超导反应后，获得<span style=\"color:#FFD780FF;\">递变信标</span>的数量提升：改为在6秒内，每1.5秒获得一枚<span style=\"color:#FFD780FF;\">递变信标</span>。"
      ]
    },
    {
      "name": "超限易爆试剂",
      "desc": [
        "<span style=\"color:#FFD780FF;\">递变信标</span>的持续时间提升至10秒。此外，创造<span style=\"color:#FFD780FF;\">递变信标</span>后的15秒内，米提亚的暴击率提升5%，该效果至多叠加4层。"
      ]
    },
    {
      "name": "星耀祝礼·极密协议",
      "desc": [
        "队伍中的角色触发超导反应时，将转为触发星超导反应。触发星超导反应时，将不会创造<span style=\"color:#FFD780FF;\">星辉棱晶</span>，而是改为在触发星超导反应后的3秒内，每1.5秒在附近创造一枚可以被米提亚携带的<span style=\"color:#FFD780FF;\">递变信标</span>，并将其附近更大的区域变换为<span style=\"color:#FFD780FF;\">极星辉域</span>。",
        "此外，基于米提亚的元素精通，提升队伍中附近的所有角色造成的星超导反应的基础伤害：每点元素精通都将提升0.028%星超导反应的基础伤害，至多通过这种方式提升14%基础伤害。处于<span style=\"color:#FFD780FF;\">极星辉域</span>中时，米提亚还会进入<span style=\"color:#FFD780FF;\">辉映·星超导</span>状态。"
      ]
    },
    {
      "name": "能源活性催化",
      "desc": [
        "周围存在可破坏的岩块时，<span style=\"color:#FFD780FF;\">侦测炉心·稳态</span>可以快速清理岩块。",
        "此外，米提亚在队伍中时，创造<span style=\"color:#FFD780FF;\">臻冰造物·简易暖源</span>时，无需消耗克什尼克能量。"
      ]
    }
  ],
  "cons": {
    "1": {
      "name": "缺位寻踪的观察者",
      "desc": [
        "<span style=\"color:#FFD780FF;\">递变信标</span>的可携带上限提升至5枚。施放元素战技<span style=\"color:#FFD780FF;\">律定·变量侦测</span>时，还会额外创造一枚<span style=\"color:#FFD780FF;\">递变信标</span>。",
        "<span style=\"color:#FFD780FF;\">侦测炉心</span>存在期间，队伍中自己的当前场上角色的暴击伤害提升40%。",
        "此外，创造<span style=\"color:#FFD780FF;\">递变信标</span>时，还会为米提亚自己恢复10点元素能量，该效果每8秒至多触发一次。"
      ]
    },
    "2": {
      "name": "惰性之外的沉寂物",
      "desc": [
        "<span style=\"color:#FFD780FF;\">侦测炉心</span>存在期间，处于<span style=\"color:#FFD780FF;\">极星辉域</span>内的所有敌人<span style=\"color:#99FFFFFF;\">冰元素抗性</span>与<span style=\"color:#FFACFFFF;\">雷元素抗性</span>降低20%。",
        "此外，若创造的<span style=\"color:#FFD780FF;\">侦测炉心</span>为：",
        "·稳态：队伍中附近的所有角色的元素精通提升123点；",
        "·过载：队伍中自己的当前场上角色的元素精通提升234点。"
      ]
    },
    "3": {
      "name": "拓扑不变的扭结弦",
      "desc": [
        "元素战技<span style=\"color:#FFD780FF;\">律定·变量侦测</span>的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "4": {
      "name": "衰变相生的同位素",
      "desc": [
        "场上存在米提亚自己创造的<span style=\"color:#FFD780FF;\">侦测炉心</span>时，每消耗5枚<span style=\"color:#FFD780FF;\">递变信标</span>，<span style=\"color:#FFD780FF;\">侦测炉心</span>都会对周围的敌人造成一次相当于米提亚元素精通300%的、视为星超导反应伤害的<span style=\"color:#FFACFFFF;\">雷元素范围伤害</span>。"
      ]
    },
    "5": {
      "name": "勘定万物的周期律",
      "desc": [
        "普通攻击<span style=\"color:#FFD780FF;\">链式反应</span>的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "6": {
      "name": "元素阶跃的理之门",
      "desc": [
        "<span style=\"color:#FFD780FF;\">侦测炉心</span>获得强化。若创造的<span style=\"color:#FFD780FF;\">侦测炉心</span>为：",
        "·稳态：<span style=\"color:#FFD780FF;\">侦测炉心</span>造成原本115%的伤害；",
        "·过载：消耗<span style=\"color:#FFD780FF;\">递变信标</span>时，有34%的概率创造一枚新的<span style=\"color:#FFD780FF;\">递变信标</span>。",
        "此外，队伍中附近的所有角色造成的星超导反应伤害<span style=\"color:#FFD780FF;\">擢升</span>20%。",
        "<h3>● 擢升</h3>",
        "特殊的伤害提升效果，与其他的伤害提升效果分别独立计算。"
      ]
    }
  },
