  "cons": {
    "1": {
      "name": "命座1",
      "desc": [
        "薇斯纳的<span style=\"color:#FFD780FF;\"><u>「灵剑武装」</u></span>状态下，灵剑·舞的可用次数增加1次，且进入「灵剑武装」状态后首次施放<span style=\"color:#FFD780FF;\"><u>灵剑·舞</u></span>将不消耗「灵剑魔力」。",
        "此外，「灵剑武装」状态持续期间，薇斯纳自身造成的星扩散反应伤害提升20%。"
      ]
    },
    "2": {
      "name": "命座2",
      "desc": [
        "突破天赋<span style=\"color:#FFD780FF;\"><u>从容</u></span>的效果获得强化：薇斯纳进入<span style=\"color:#FFD780FF;\"><u>「灵剑武装」</u></span>状态时，立刻获得满层的「从容」。",
        "此外，薇斯纳在「从容」处于满层时，攻击力提升60%。"
      ]
    },
    "3": {
      "name": "命座3",
      "desc": [
        "元素战技<span style=\"color:#FFD780FF;\"><u>灵剑·起</u></span>的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "4": {
      "name": "命座4",
      "desc": [
        "薇斯纳突破天赋<span style=\"color:#FFD780FF;\"><u>游刃</u></span>提供的效果提升200%。"
      ]
    },
    "5": {
      "name": "命座5",
      "desc": [
        "元素爆发<span style=\"color:#FFD780FF;\"><u>灵剑·爆</u></span>的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "6": {
      "name": "命座6",
      "desc": [
        "施放<span style=\"color:#FFD780FF;\"><u>灵剑·舞</u></span>后的5秒内，薇斯纳可以通过点按元素战技或普攻，施放<span style=\"color:#FFD780FF;\">灵剑·踏</span>：",
        "·造成150%攻击力的<span style=\"color:#80FFD7FF;\">风元素伤害</span>，并同时驱动<span style=\"color:#FFD780FF;\">星灵剑</span>造成200%攻击力的视为星扩散反应伤害的<span style=\"color:#80FFD7FF;\">风元素伤害</span>；",
        "·若薇斯纳处于灵剑武装状态时，该攻击动作也能召唤<span style=\"color:#FFD780FF;\">灵羽</span>。",
        "灵剑·踏产生的星灵剑也能够获得突破天赋一的强化。",
        "此外，薇斯纳的星扩散反应伤害<span style=\"color:#FFD780FF;\"><u>擢升</u></span>20%。",
        "<h3>● 擢升</h3>",
        "特殊的伤害提升效果，与其他的伤害提升效果分别独立计算。"
      ]
    }
  },
  "passive": [
    {
      "name": "从容",
      "desc": [
        "薇斯纳施放<span style=\"color:#FFD780FF;\"><u>灵剑·刺</u></span>、<span style=\"color:#FFD780FF;\"><u>灵剑·落</u></span>、<span style=\"color:#FFD780FF;\"><u>灵剑·舞</u></span>或元素爆发<span style=\"color:#FFD780FF;\"><u>灵剑·爆</u></span>后，获得1层「从容」，持续20秒，至多叠加6层；施放元素战技<span style=\"color:#FFD780FF;\"><u>灵剑·起</u></span>或离场时，所有「从容」将被清除。",
        "每层「从容」都将使薇斯纳所有的<span style=\"color:#FFD780FF;\">灵剑</span>和<span style=\"color:#FFD780FF;\">星灵剑</span>造成比原本高10%的伤害，至多造成原本160%的伤害。"
      ]
    },
    {
      "name": "游刃",
      "desc": [
        "<span style=\"color:#FFD780FF;\">辉映·星扩散</span>：依据队伍中角色的元素属性（包括薇斯纳自己），薇斯纳将获得额外加成：",
        "·每有一位<span style=\"color:#99FFFFFF;\">冰元素</span>或<span style=\"color:#80FFD7FF;\">风元素</span>角色，使薇斯纳的攻击力提升6%；",
        "·每有一位其他元素角色，使薇斯纳的元素精通提升25点。"
      ]
    },
    {
      "name": "星耀祝礼·闪耀的妖精",
      "desc": [
        "队伍中的角色触发冰元素扩散反应时，将转为触发星扩散反应，且基于薇斯纳的攻击力，提升队伍中角色造成的星扩散反应的基础伤害：每100点攻击力都将提升0.7%星扩散反应的基础伤害，至多通过这种方式提升14%。",
        "队伍中的角色在附近触发星扩散反应后的8秒内，薇斯纳将会进入<span style=\"color:#FFD780FF;\">辉映·星扩散</span>状态。"
      ]
    },
    {
      "name": "轻羽",
      "desc": [
        "非战斗状态下，薇斯纳可通过以下方式进入<span style=\"color:#FFD780FF;\">「巡游」</span>状态：",
        "·长按冲刺，进行一段快速突进后进入「巡游」状态；",
        "·长按跳跃，进行一小段快速飞升后进入「巡游」状态。",
        "<h3>「巡游」</h3>",
        "·浮空并持续消耗体力，部分行为发生变化：",
        "·跳跃：消耗体力并进行一次飞跃；",
        "·冲刺：消耗体力并快速向前冲刺一小段距离；",
        "·点按元素战技、普攻或体力耗尽时将退出巡游状态，若处于高空则点按普攻将使出下落攻击；",
        "·包含进入巡游状态时使用的飞跃在内，薇斯纳在一次巡游状态下至多进行三次飞跃。",
        "此外，在至冬地区非战斗状态下，当队伍中的其他角色在前台处于空中状态时，可切出薇斯纳施放<span style=\"color:#FFD780FF;\">「闪耀登场」</span>，薇斯纳将直接进入「巡游」状态，并恢复50点体力。",
        "「闪耀登场」每10秒至多使用1次。"
      ]
    }
  ],
