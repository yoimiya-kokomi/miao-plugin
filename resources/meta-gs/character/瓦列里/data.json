  "passive": [
    {
      "name": "与徐进弹幕为伴",
      "desc": [
        "元素爆发<span style=\"color:#FFD780FF;\">火力焦点·雷霰急袭</span>中的<span style=\"color:#FFD780FF;\">雷霰重弹</span>下坠期间，队伍中附近的当前场上其他角色的元素类型为<span style=\"color:#FFACFFFF;\">雷元素</span>的攻击命中敌人时，瓦列里将获得5点<span style=\"color:#FFD780FF;\">冲击势能</span>。每次施放元素爆发后，至多通过这种方式获得80点<span style=\"color:#FFD780FF;\">冲击势能</span>。"
      ]
    },
    {
      "name": "向防线缺口突击",
      "desc": [
        "<span style=\"color:#FFD780FF;\">攻斥指令</span>获得强化：依据进行特殊重击<span style=\"color:#FFD780FF;\">臼炮直射·抵近轰击</span>时消耗的<span style=\"color:#FFD780FF;\">冲击势能</span>，每消耗一点<span style=\"color:#FFD780FF;\">冲击势能</span>，都会使<span style=\"color:#FFD780FF;\">攻斥指令</span>的伤害加成效果进一步提升。若瓦列里：",
        "·处于<span style=\"color:#FFD780FF;\">辉映·星超导</span>状态：每点消耗的<span style=\"color:#FFD780FF;\">冲击势能</span>都会使<span style=\"color:#FFD780FF;\">攻斥指令</span>的伤害加成效果提升，提升值相当于瓦列里攻击力的0.9%；",
        "·不处于<span style=\"color:#FFD780FF;\">辉映·星超导</span>状态：每点消耗的<span style=\"color:#FFD780FF;\">冲击势能</span>都会使<span style=\"color:#FFD780FF;\">攻斥指令</span>的伤害加成效果提升，提升值相当于瓦列里攻击力的0.3%。"
      ]
    },
    {
      "name": "冰原行动情报",
      "desc": [
        "在至冬（挪德卡莱除外）执行时长为20小时的探索派遣任务时，获得的奖励增加25%。"
      ]
    }
  ],
  "cons": {
    "1": {
      "name": "持续压制的时序",
      "desc": [
        "进行特殊重击<span style=\"color:#FFD780FF;\">臼炮直射·抵近轰击</span>后，会为瓦列里恢复6点元素能量。依据进行特殊重击时消耗的<span style=\"color:#FFD780FF;\">冲击势能</span>，超过40点的部分，每消耗10点，都会使瓦列里额外恢复1.5点元素能量。每次进行特殊重击<span style=\"color:#FFD780FF;\">臼炮直射·抵近轰击</span>，至多通过这种方式为瓦列里恢复15点元素能量。该效果每15秒至多触发一次。",
        "此外，每次进入战斗状态时，瓦列里首次施放元素战技<span style=\"color:#FFD780FF;\">攻势防御·堡垒骤进</span>时，还会额外获得相当于原本150%的<span style=\"color:#FFD780FF;\">冲击势能</span>。"
      ]
    },
    "2": {
      "name": "伴随冲阵的队型",
      "desc": [
        "施放元素战技<span style=\"color:#FFD780FF;\">攻势防御·堡垒骤进</span>后的18秒内，队伍中附近的所有角色的元素精通提升100点。",
        "此外，处于蓄雷护盾庇护下时，若瓦列里的<span style=\"color:#FFD780FF;\">冲击势能</span>已达到上限，触发获取<span style=\"color:#FFD780FF;\">冲击势能</span>的效果时，将转为提升蓄雷护盾的伤害吸收量，每1点溢出的<span style=\"color:#FFD780FF;\">冲击势能</span>都会使蓄雷护盾的伤害吸收量提升瓦列里攻击力的8%，至多通过这种方式转化20点溢出的<span style=\"color:#FFD780FF;\">冲击势能</span>。"
      ]
    },
    "3": {
      "name": "白刃对决的戒备",
      "desc": [
