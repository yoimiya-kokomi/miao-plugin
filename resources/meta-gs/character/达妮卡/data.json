  "passive": [
    {
      "name": "古海浪的咏歌",
      "desc": [
        "<span style=\"color:#FFD780FF;\">准雷定锚</span>还会使附近敌人的<span style=\"color:#FFACFFFF;\">雷元素抗性</span>降低15%。",
        "<span style=\"color:#FFD780FF;\">辉映·星超导</span>：<span style=\"color:#FFD780FF;\">准雷定锚</span>附近敌人的<span style=\"color:#FFACFFFF;\">雷元素抗性</span>额外降低15%，<span style=\"color:#99FFFFFF;\">冰元素抗性</span>降低30%。"
      ]
    },
    {
      "name": "应是扫除之日",
      "desc": [
        "施放<span style=\"color:#FFD780FF;\">荡除之志</span>后，达妮卡的攻击速度提升20%，且挥舞<span style=\"color:#FFD780FF;\">准雷定锚</span>进行普通攻击命中敌人时，还会额外获得25点<span style=\"color:#FFD780FF;\">涤尘的心意</span>；上述效果至多叠加3层。",
        "施放<span style=\"color:#FFD780FF;\">护持之志</span>后，达妮卡的攻击力提升20%。",
        "上述每种效果分别持续至对应的<span style=\"color:#FFD780FF;\">侍者形态</span>结束。"
      ]
    },
    {
      "name": "星耀祝礼·纤毫不遗",
      "desc": [
        "队伍中的角色触发超导反应时，将转为触发星超导反应，且基于达妮卡的攻击力，提升队伍中角色造成的星超导反应的基础伤害：每100点攻击力都将提升0.7%星超导反应的基础伤害，至多通过这种方式提升14%伤害。",
        "此外，处于<span style=\"color:#FFD780FF;\">极星辉域</span>中时，达妮卡将会进入<span style=\"color:#FFD780FF;\">辉映·星超导</span>状态。",
        "<h3>● 极星辉域</h3>",
        "触发星超导反应时，附近的区域会短暂变化为<span style=\"color:#FFD780FF;\">极星辉域</span>；处于极星辉域中时，特定角色将会进入<span style=\"color:#FFD780FF;\">辉映·星超导</span>状态，使其不同技能分别获得对应的强化效果。"
      ]
    },
    {
      "name": "霜雪无犯之姿",
      "desc": [
        "队伍中自己的角色处于严寒环境中时，移动速度提高10%，体力消耗降低10%。"
      ]
    }
  ],
  "cons": {
    "1": {
      "name": "冰宫殿的奉侍",
      "desc": [
        "施放特殊元素战技<span style=\"color:#FFD780FF;\">荡除之志</span>或<span style=\"color:#FFD780FF;\">护持之志</span>时，还会为达妮卡恢复20点元素能量，该效果每14秒至多触发一次。",
        "此外，施放元素爆发<span style=\"color:#FFD780FF;\">净世卫仪</span>后，<span style=\"color:#FFD780FF;\">女仆·清扫者</span>形态对应的强化效果提升120%，<span style=\"color:#FFD780FF;\">女仆·御前护卫</span>形态对应的强化效果提升80%。"
      ]
    },
    "2": {
      "name": "炽流砂的静心",
      "desc": [
        "施放元素战技<span style=\"color:#FFD780FF;\">涤尘准锚</span>时，达妮卡还会为队伍中附近的所有角色赋予7层<span style=\"color:#FFD780FF;\">祝酒</span>。",
        "持有该效果的角色造成星超导反应伤害时，将消耗一层<span style=\"color:#FFD780FF;\">祝酒</span>，提升造成的伤害，提升至相当于达妮卡攻击力的100%。",
        "此外，达妮卡在<span style=\"color:#FFD780FF;\">女仆·清扫者</span>形态下造成星超导反应伤害时，还会消耗自身所有的<span style=\"color:#FFD780FF;\">祝酒</span>，提升造成的伤害，提升至相当于达妮卡攻击力的150%。",
        "队伍中附近的所有角色累计消耗6层<span style=\"color:#FFD780FF;\">祝酒</span>时，还会额外为队伍中自己的当前场上角色赋予1层<span style=\"color:#FFD780FF;\">祝酒</span>；施放元素战技<span style=\"color:#FFD780FF;\">涤尘准锚</span>或特殊元素战技<span style=\"color:#FFD780FF;\">护持之志</span>时，将重置队伍中附近的所有角色拥有的<span style=\"color:#FFD780FF;\">祝酒</span>层数。"
      ]
    },
    "3": {
      "name": "刃林锋的游影",
      "desc": [
        "元素爆发<span style=\"color:#FFD780FF;\">净世卫仪</span>的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "4": {
      "name": "苦寒地的护持",
      "desc": [
        "处于御卫护盾庇护下的当前场上角色对敌人造成星超导反应伤害时，还会为队伍中附近的其他角色恢复3点元素能量，该效果每3.5秒至多触发一次。",
        "此外，达妮卡进入<span style=\"color:#FFD780FF;\">女仆·清扫者</span>形态时，也会展开御卫护盾，持续至达妮卡退出该形态或退场。"
      ]
    },
    "5": {
      "name": "纠葛场的斡旋",
      "desc": [
        "元素战技<span style=\"color:#FFD780FF;\">涤尘准锚</span>的技能等级提高3级。",
        "至多提升至15级。"
      ]
    },
    "6": {
      "name": "醒于晨前之星",
      "desc": [
        "<span style=\"color:#FFD780FF;\">准雷定锚</span>存在期间，队伍中附近的角色造成的星超导反应伤害<span style=\"color:#FFD780FF;\">擢升</span>20%。",
        "此外，达妮卡的<span style=\"color:#FFD780FF;\">侍者形态</span>获得强化：",
        "<span style=\"color:#FFD780FF;\">女仆·御前护卫</span>形态：基于达妮卡的攻击力，每1000点攻击力都会使队伍中当前场上角色造成的星超导反应伤害提升10%，至多提升40%；",
        "<span style=\"color:#FFD780FF;\">女仆·清扫者</span>形态：基于达妮卡的攻击力，每500点攻击力都会使达妮卡的特殊元素战技<span style=\"color:#FFD780FF;\">荡除之志</span>的暴击率提升2.5%，暴击伤害提升25%，至多通过这种方式使暴击率提升10%，暴击伤害提升100%。",
        "上述强化效果持续至达妮卡退出对应的<span style=\"color:#FFD780FF;\">侍者形态</span>。",
        "<h3>● 擢升</h3>",
        "特殊的伤害提升效果，与其他的伤害提升效果分别独立计算。"
      ]
    }
