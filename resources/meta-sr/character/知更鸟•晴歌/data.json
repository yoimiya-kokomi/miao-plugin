  "cons": {
    "1": {
      "name": "夏日离群飞鸟",
      "desc": "「晴空乐手」会记录我方目标造成的非<u>真实伤害</u>的<nobr>100%</nobr>，施放忆灵技时对生命值最高的敌方目标额外造成记录伤害总额<nobr>11%</nobr>+当前气氛值点数*<nobr>0.1%</nobr>的<u>真实伤害</u>，随后清空记录值的<nobr>50%</nobr>。"
    },
    "2": {
      "name": "心似一片湖水",
      "desc": "我方目标的全属性<u>抗性穿透</u>提高<nobr>18%</nobr>。知更鸟•晴歌的气氛值上限提高<nobr>20</nobr>点，我方目标在任意目标回合内第一次施放技能使知更鸟•晴歌获得气氛值时额外获得<nobr>2</nobr>点。"
    },
    "3": {
      "name": "拾取沿途遗音",
      "desc": "战技等级+2，最多不超过<nobr>15</nobr>级；天赋等级+2，最多不超过<nobr>15</nobr>级；忆灵天赋等级+1，最多不超过<nobr>10</nobr>级。"
    },
    "4": {
      "name": "聆听众弦的变奏",
      "desc": "进入【Fever】状态时，立即获得<nobr>12</nobr>点气氛值，「晴空乐手」的速度提高<nobr>20%</nobr>+当前气氛值*<nobr>0.5%</nobr>。"
    },
    "5": {
      "name": "然后再次共逐新晨",
      "desc": "终结技等级+2，最多不超过<nobr>15</nobr>级；普攻等级+1，最多不超过<nobr>10</nobr>级；忆灵技等级+1，最多不超过<nobr>10</nobr>级。"
    },
    "6": {
      "name": "唱一首未命名的歌",
      "desc": "忆灵技的伤害倍率提高原倍率的<nobr>100%</nobr>。处于【Fever】状态时，知更鸟•晴歌的终结技可以最多储存2次，本场战斗中第一次进入【Fever】状态后或【Fever】倒计时回合开始时，固定恢复<nobr>140</nobr>点能量。"
